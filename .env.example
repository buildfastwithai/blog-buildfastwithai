# Supabase (read-only public data + newsletter signups). Same project as the
# main site — the blog tables live there.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public URL of this deployment. Used for canonicals, sitemap, RSS and JSON-LD.
# Defaults to https://blog.buildfastwithai.com when unset.
NEXT_PUBLIC_SITE_URL=https://blog.buildfastwithai.com

# Set to "true" on preview/staging deployments (and on production until the
# domain is ready to be indexed). Emits noindex + a disallow-all robots.txt.
NEXT_PUBLIC_NOINDEX=false

# Analytics
NEXT_PUBLIC_POSTHOG_KEY=

# Luma calendar — powers the "next workshop" card in the article sidebar.
LUMA_API_KEY=

# Shared secret for /api/revalidate/blog (on-demand ISR purge after publishing).
REVALIDATE_SECRET=

# Tune how many recent posts are pre-rendered at build time (default 50).
BLOG_PREBUILD_COUNT=50
